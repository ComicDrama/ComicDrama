generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EpisodeStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  ARCHIVED
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(120)
  name        String        @db.VarChar(200)
  description String?
  status      ProjectStatus @default(DRAFT)
  version     Int           @default(1)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seasons Season[]

  @@index([status])
  @@index([archivedAt])
  @@map("projects")
}

model Season {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  number      Int
  title       String?      @db.VarChar(200)
  description String?
  status      SeasonStatus @default(DRAFT)
  version     Int          @default(1)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  episodes Episode[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([archivedAt])
  @@map("seasons")
}

model Episode {
  id              String        @id @default(uuid()) @db.Uuid
  seasonId        String        @db.Uuid
  number          Int
  title           String?       @db.VarChar(200)
  synopsis        String?
  status          EpisodeStatus @default(DRAFT)
  version         Int           @default(1)
  durationSeconds Int?
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([seasonId, number])
  @@index([seasonId, status])
  @@index([archivedAt])
  @@map("episodes")
}
