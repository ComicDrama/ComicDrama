  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items   AssetCollectionItem[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([projectId, archivedAt])
  @@index([archivedAt])
  @@map("asset_collections")
}

model AssetCollectionItem {
  id              String   @id @default(uuid()) @db.Uuid
  collectionId    String   @db.Uuid
  assetId         String   @db.Uuid
  pinnedVersionId String?  @db.Uuid
  createdAt       DateTime @default(now())

  collection    AssetCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  asset         Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pinnedVersion AssetVersion?   @relation(fields: [pinnedVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([collectionId, assetId])
  @@index([assetId])
  @@index([pinnedVersionId])
  @@map("asset_collection_items")
}

model AssetReference {
  id             String   @id @default(uuid()) @db.Uuid
  assetId        String   @db.Uuid
  assetVersionId String   @db.Uuid
  targetType     String   @db.VarChar(50)
  targetId       String   @db.Uuid
  role           String?  @db.VarChar(80)
  notes          String?
  metadata       Json?
  createdAt      DateTime @default(now())

  asset         Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assetVersion  AssetVersion @relation(fields: [assetVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shotVersion   ShotVersion? @relation(fields: [shotVersionId], references: [id])
  shotVersionId String?      @db.Uuid

  @@unique([assetVersionId, targetType, targetId, role])
  @@index([assetId, targetType])
  @@index([assetVersionId])
  @@index([targetType, targetId])
  @@map("asset_references")
}

model Timeline {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String         @db.Uuid
  episodeId        String         @db.Uuid
  name             String         @db.VarChar(200)
  status           TimelineStatus @default(DRAFT)
  currentVersionId String?        @unique @db.Uuid
  version          Int            @default(1)
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  episode        Episode           @relation(fields: [episodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions       TimelineVersion[] @relation("TimelineVersions")
  currentVersion TimelineVersion?  @relation("TimelineCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([episodeId, name])
  @@index([episodeId, status])
  @@index([projectId, status])
  @@index([projectId, archivedAt])
  @@index([archivedAt])
  @@map("timelines")
}

model TimelineVersion {
  id              String                @id @default(uuid()) @db.Uuid
  timelineId      String                @db.Uuid
  parentVersionId String?               @db.Uuid
  version         Int
  status          TimelineVersionStatus @default(DRAFT)
  timebase        Int                   @default(24)
  durationFrames  Int                   @default(0)
  metadata        Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  timeline      Timeline          @relation("TimelineVersions", fields: [timelineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentVersion TimelineVersion?  @relation("TimelineVersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childVersions TimelineVersion[] @relation("TimelineVersionLineage")
  currentOf     Timeline?         @relation("TimelineCurrentVersion")
  tracks        Track[]
  transitions   Transition[]
  renderJobs    RenderJob[]

  @@unique([timelineId, version])
  @@index([timelineId, status])
  @@index([parentVersionId])
  @@map("timeline_versions")
}

model Track {
  id                String    @id @default(uuid()) @db.Uuid
  timelineVersionId String    @db.Uuid
  name              String    @db.VarChar(200)
  type              TrackType
  sortOrder         Int       @default(0)
  muted             Boolean   @default(false)
  locked            Boolean   @default(false)
  volume            Float?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  timelineVersion TimelineVersion @relation(fields: [timelineVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  clips           Clip[]

  @@unique([timelineVersionId, name])
  @@index([timelineVersionId, type, sortOrder])
  @@map("timeline_tracks")
}

model Clip {
  id                    String         @id @default(uuid()) @db.Uuid
  trackId               String         @db.Uuid
  sourceType            ClipSourceType
  assetVersionId        String?        @db.Uuid
  generationCandidateId String?        @db.Uuid
  timelineStartFrame    Int
  durationFrames        Int
  sourceInFrame         Int            @default(0)
  sourceOutFrame        Int?
  playbackRate          Float          @default(1)
  transform             Json?
  effects               Json?
  metadata              Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  track               Track                @relation(fields: [trackId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assetVersion        AssetVersion?        @relation("ClipAssetVersion", fields: [assetVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  generationCandidate GenerationCandidate? @relation("ClipGenerationCandidate", fields: [generationCandidateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  outgoingTransitions Transition[]         @relation("TransitionOutgoing")
  incomingTransitions Transition[]         @relation("TransitionIncoming")
  keyframes           Keyframe[]

  @@index([trackId, timelineStartFrame])
  @@index([assetVersionId])
  @@index([generationCandidateId])
  @@map("timeline_clips")
}

model Transition {
  id                String         @id @default(uuid()) @db.Uuid
  timelineVersionId String         @db.Uuid
  outgoingClipId    String         @db.Uuid
  incomingClipId    String         @db.Uuid
  type              TransitionType
  startFrame        Int
  durationFrames    Int
  parameters        Json?
  createdAt         DateTime       @default(now())

  timelineVersion TimelineVersion @relation(fields: [timelineVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  outgoingClip    Clip            @relation("TransitionOutgoing", fields: [outgoingClipId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  incomingClip    Clip            @relation("TransitionIncoming", fields: [incomingClipId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([outgoingClipId, incomingClipId])
  @@index([timelineVersionId, startFrame])
  @@map("timeline_transitions")
}

model Keyframe {
  id            String            @id @default(uuid()) @db.Uuid
  clipId        String            @db.Uuid
  property      KeyframeProperty
  frame         Int
  value         Json
  interpolation InterpolationType @default(LINEAR)
  easing        String?           @db.VarChar(80)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([clipId, property, frame])
  @@index([clipId, property, frame])
  @@map("timeline_keyframes")
}

model Review {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @db.Uuid
  targetType  ReviewTargetType
  targetId    String           @db.Uuid
  status      ReviewStatus     @default(DRAFT)
  revision    Int              @default(1)
  title       String?          @db.VarChar(240)
  summary     String?
  metadata    Json?
  submittedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  comments  ReviewComment[]
  approvals Approval[]

  @@index([projectId, status])
  @@index([targetType, targetId, revision])
  @@map("reviews")
}

model ReviewComment {
  id            String              @id @default(uuid()) @db.Uuid
  reviewId      String              @db.Uuid
  authorId      String?             @db.VarChar(120)
  body          String
  timecodeFrame Int?
  targetPath    String?             @db.VarChar(300)
  status        ReviewCommentStatus @default(OPEN)
  resolvedById  String?             @db.VarChar(120)
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([reviewId, status, createdAt])
  @@index([authorId])
  @@map("review_comments")
}

model Approval {
  id         String           @id @default(uuid()) @db.Uuid
  reviewId   String           @db.Uuid
  reviewerId String           @db.VarChar(120)
  role       ApprovalRole
  decision   ApprovalDecision @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime         @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([reviewId, decision])
  @@index([reviewerId, createdAt])
  @@map("review_approvals")
}

model RenderJob {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @db.Uuid
  timelineVersionId String          @db.Uuid
  exportPresetId    String          @db.Uuid
  idempotencyKey    String?         @unique @db.VarChar(240)
  status            RenderJobStatus @default(QUEUED)
  outputStorageKey  String?         @db.VarChar(500)
  outputFileName    String?         @db.VarChar(255)
  mimeType          String?         @db.VarChar(120)
  width             Int?
  height            Int?
  durationMs        Int?
  errorCode         String?         @db.VarChar(80)
  errorMessage      String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime        @updatedAt

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  timelineVersion TimelineVersion @relation(fields: [timelineVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  exportPreset    ExportPreset    @relation(fields: [exportPresetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  segments        RenderSegment[]
  usageRecords    UsageRecord[]
  costRecords     CostRecord[]

  @@index([projectId, status, createdAt])
  @@index([timelineVersionId, createdAt])
  @@index([exportPresetId])
  @@map("render_jobs")
}

model RenderSegment {
  id           String              @id @default(uuid()) @db.Uuid
  renderJobId  String              @db.Uuid
  segmentIndex Int
  startFrame   Int
  endFrame     Int
  status       RenderSegmentStatus @default(PENDING)
  cacheKey     String?             @db.VarChar(500)
  storageKey   String?             @db.VarChar(500)
  durationMs   Int?
  errorCode    String?             @db.VarChar(80)
  errorMessage String?
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?

  renderJob RenderJob @relation(fields: [renderJobId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([renderJobId, segmentIndex])
  @@index([renderJobId, status, segmentIndex])
  @@index([cacheKey])
  @@map("render_segments")
}

model ExportPreset {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String?   @db.Uuid
  name            String    @db.VarChar(200)
  slug            String    @db.VarChar(120)
  container       String    @db.VarChar(40)
  videoCodec      String?   @db.VarChar(80)
  audioCodec      String?   @db.VarChar(80)
  width           Int
  height          Int
  fps             Float
  bitrate         Int?
  audioSampleRate Int?
  aspectRatio     String?   @db.VarChar(20)
  isDefault       Boolean   @default(false)
  version         Int       @default(1)
  archivedAt      DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  renderJobs RenderJob[]

  @@unique([projectId, slug])
  @@index([projectId, isDefault])
  @@index([projectId, archivedAt])
  @@index([archivedAt])
  @@map("export_presets")
}

model UsageRecord {
  id            String          @id @default(uuid()) @db.Uuid
  projectId     String?         @db.Uuid
  generationId  String?         @db.Uuid
  providerJobId String?         @db.Uuid
  renderJobId   String?         @db.Uuid
  sourceType    UsageSourceType
  metric        UsageMetric
  resourceType  String?         @db.VarChar(80)
  resourceId    String?         @db.Uuid
  provider      String?         @db.VarChar(120)
  model         String?         @db.VarChar(160)
  quantity      Decimal         @db.Decimal(24, 8)
  unit          String          @db.VarChar(40)
  inputTokens   Int?
  outputTokens  Int?
  durationMs    Int?
  metadata      Json?
  occurredAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())

  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  generation  Generation?  @relation(fields: [generationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  providerJob ProviderJob? @relation(fields: [providerJobId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  renderJob   RenderJob?   @relation(fields: [renderJobId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  costs       CostRecord[]

  @@index([projectId, occurredAt])
  @@index([sourceType, metric, occurredAt])
  @@index([generationId])
  @@index([providerJobId])
  @@index([renderJobId])
  @@index([resourceType, resourceId])
  @@map("usage_records")
}

model CostRecord {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String?      @db.Uuid
  usageRecordId String?      @db.Uuid
  generationId  String?      @db.Uuid
  renderJobId   String?      @db.Uuid
  category      CostCategory
  status        CostStatus   @default(ACCRUED)
  provider      String?      @db.VarChar(120)
  model         String?      @db.VarChar(160)
  description   String?
  quantity      Decimal?     @db.Decimal(24, 8)
  unit          String?      @db.VarChar(40)
  unitPrice     Decimal?     @db.Decimal(24, 8)
  amount        Decimal      @db.Decimal(18, 6)
  currency      String       @default("USD") @db.VarChar(12)
  metadata      Json?
  incurredAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  usageRecord UsageRecord? @relation(fields: [usageRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  generation  Generation?  @relation(fields: [generationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  renderJob   RenderJob?   @relation(fields: [renderJobId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([projectId, incurredAt])
  @@index([category, status, incurredAt])
  @@index([usageRecordId])
  @@index([generationId])
  @@index([renderJobId])
  @@map("cost_records")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String?  @db.Uuid
  actorId    String?  @db.VarChar(120)
  actorType  String?  @db.VarChar(40)
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(120)
  requestId  String?  @db.VarChar(120)
  traceId    String?  @db.VarChar(120)
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([projectId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([traceId])
  @@map("audit_logs")
}
