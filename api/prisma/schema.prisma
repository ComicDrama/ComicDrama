generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ProjectAccessLevel {
  VIEW
  EDIT
  MANAGE
}

enum ProjectRole {
  OWNER
  PRODUCER
  DIRECTOR
  SCREENWRITER
  STORYBOARD_ARTIST
  ASSET_ARTIST
  EDITOR
  REVIEWER
  VIEWER
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EpisodeStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  ARCHIVED
}

enum SourceDocumentType {
  TXT
  MARKDOWN
  DOCX
  EPUB
  PDF
  FOUNTAIN
  FINAL_DRAFT_XML
  UNKNOWN
}

enum SourceDocumentStatus {
  DRAFT
  IMPORTING
  READY
  FAILED
  ARCHIVED
}

enum SourceVersionStatus {
  IMPORTING
  PARSING
  READY
  FAILED
}

enum SourceSegmentType {
  DOCUMENT
  CHAPTER
  SECTION
  PARAGRAPH
}

enum ChapterEntityExtractionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ExtractedEntityType {
  CHARACTER
  LOCATION
  PROP
  ORGANIZATION
  TIME
  EVENT
}

enum ScriptStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  ARCHIVED
}

enum ScriptVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum ScriptAdaptationMode {
  SIMPLE
  STANDARD
  COMPLETE
}

enum BeatType {
  ACTION
  REVEAL
  EMOTION
  TRANSITION
  DIALOGUE
  MONTAGE
}

enum DialogueType {
  SPOKEN
  VOICE_OVER
  OFF_SCREEN
  WHISPER
  SHOUT
}

enum ShotStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  ARCHIVED
}

enum ShotVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum ShotDependencyType {
  CONTINUITY
  MATCH_CUT
  CARRY_OVER
  REFERENCE
  TIMELINE
}

enum StoryboardPanelType {
  KEYFRAME
  THUMBNAIL
  CAMERA_BOARD
  ANNOTATION
}

enum GenerationStrategy {
  NONE
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  KEYFRAME_TO_VIDEO
}

enum AssetType {
  CHARACTER
  LOCATION
  PROP
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STYLE
  OTHER
}

enum AssetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssetVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum CharacterStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CharacterAppearanceType {
  TURNAROUND
  FRONT
  SIDE
  BACK
  EXPRESSION
  POSE
  COSTUME
  REFERENCE
  OTHER
}

enum VoiceProfileStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LocationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LocationVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum PropStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SceneContinuitySubject {
  CHARACTER
  LOCATION
  PROP
  OTHER
}

enum GenerationType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  TTS
  RENDER
}

enum GenerationStatus {
  DRAFT
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum GenerationCandidateStatus {
  PENDING
  READY
  SELECTED
  REJECTED
  FAILED
  ARCHIVED
}

enum ProviderJobStatus {
  SUBMITTED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  UNKNOWN
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum TaskStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  RETRYING
  FAILED
  CANCELLED
}

enum TaskAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum TimelineStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  ARCHIVED
}

enum TimelineVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum TrackType {
  VIDEO
  AUDIO
  SUBTITLE
}

enum ClipSourceType {
  ASSET_VERSION
  GENERATION_CANDIDATE
}

enum TransitionType {
  CUT
  DISSOLVE
  FADE_IN
  FADE_OUT
  WIPE
  SLIDE
  CUSTOM
}

enum KeyframeProperty {
  POSITION
  SCALE
  ROTATION
  OPACITY
  VOLUME
  COLOR
  BLUR
  CUSTOM
}

enum InterpolationType {
  STEP
  LINEAR
  BEZIER
}

enum UsageSourceType {
  PROVIDER
  GENERATION
  RENDER
  WORKFLOW
  STORAGE
  OTHER
}

enum UsageMetric {
  REQUESTS
  INPUT_TOKENS
  OUTPUT_TOKENS
  IMAGE_COUNT
  VIDEO_SECONDS
  AUDIO_SECONDS
  RENDER_FRAMES
  COMPUTE_SECONDS
  STORAGE_BYTES
  OTHER
}

enum CostCategory {
  AI_GENERATION
  RENDER
  STORAGE
  EGRESS
  SUBSCRIPTION
  OTHER
}

enum CostStatus {
  ESTIMATED
  ACCRUED
  REFUNDED
  VOID
}

enum ReviewTargetType {
  SCRIPT_VERSION
  SHOT_VERSION
  ASSET_VERSION
  TIMELINE_VERSION
  RENDER_JOB
  MEDIA_OBJECT
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUPERSEDED
  CANCELLED
}

enum ReviewCommentStatus {
  OPEN
  RESOLVED
  WONT_FIX
}

enum ApprovalRole {
  REVIEWER
  DIRECTOR
  PRODUCER
  EDITOR
  OTHER
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum RenderJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum RenderSegmentStatus {
  PENDING
  RUNNING
  SUCCEEDED
  CACHED
  FAILED
  CANCELLED
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(120)
  name        String        @db.VarChar(200)
  description String?
  status      ProjectStatus @default(DRAFT)
  version     Int           @default(1)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seasons                  Season[]
  episodes                 Episode[]
  sourceDocuments          SourceDocument[]
  chapterEntityExtractions ChapterEntityExtraction[]
  scripts                  Script[]
  shots                    Shot[]
  timelines                Timeline[]
  assets                   Asset[]
  assetCollections         AssetCollection[]
  characters               Character[]
  locations                Location[]
  props                    Prop[]
  generations              Generation[]
  workflows                Workflow[]
  tasks                    Task[]
  workflowRuns             WorkflowRun[]
  reviews                  Review[]
  renderJobs               RenderJob[]
  exportPresets            ExportPreset[]
  usageRecords             UsageRecord[]
  costRecords              CostRecord[]
  auditLogs                AuditLog[]
  members                  ProjectMember[]
  teamGrants               ProjectTeam[]
  memberRoles              ProjectMemberRole[]
  teamRoles                ProjectTeamRole[]

  @@index([status])
  @@index([archivedAt])
  @@map("projects")
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  email       String     @unique @db.VarChar(320)
  displayName String     @db.VarChar(200)
  status      UserStatus @default(ACTIVE)
  version     Int        @default(1)
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]

  @@index([status])
  @@index([archivedAt])
  @@map("users")
}

model Team {
  id          String     @id @default(uuid()) @db.Uuid
  slug        String     @unique @db.VarChar(120)
  name        String     @db.VarChar(200)
  description String?
  status      TeamStatus @default(ACTIVE)
  version     Int        @default(1)
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  members       TeamMember[]
  projectGrants ProjectTeam[]

  @@index([status])
  @@index([archivedAt])
  @@map("teams")
}

model TeamMember {
  id          String           @id @default(uuid()) @db.Uuid
  teamId      String           @db.Uuid
  userId      String           @db.Uuid
  status      MembershipStatus @default(INVITED)
  isAdmin     Boolean          @default(false)
  invitedAt   DateTime         @default(now())
  acceptedAt  DateTime?
  suspendedAt DateTime?
  removedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamId, userId])
  @@index([userId, status])
  @@index([teamId, status])
  @@map("team_members")
}

model ProjectMember {
  id          String             @id @default(uuid()) @db.Uuid
  projectId   String             @db.Uuid
  userId      String             @db.Uuid
  status      MembershipStatus   @default(INVITED)
  accessLevel ProjectAccessLevel @default(VIEW)
  invitedAt   DateTime           @default(now())
  acceptedAt  DateTime?
  suspendedAt DateTime?
  removedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  project Project             @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roles   ProjectMemberRole[]

  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([projectId, status, accessLevel])
  @@map("project_members")
}

model ProjectTeam {
  id          String             @id @default(uuid()) @db.Uuid
  projectId   String             @db.Uuid
  teamId      String             @db.Uuid
  status      MembershipStatus   @default(ACTIVE)
  accessLevel ProjectAccessLevel @default(VIEW)
  grantedAt   DateTime           @default(now())
  revokedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  project Project           @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  team    Team              @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roles   ProjectTeamRole[]

  @@unique([projectId, teamId])
  @@index([teamId, status])
  @@index([projectId, status, accessLevel])
  @@map("project_teams")
}

model ProjectMemberRole {
  id              String      @id @default(uuid()) @db.Uuid
  projectId       String      @db.Uuid
  projectMemberId String      @db.Uuid
  role            ProjectRole
  createdAt       DateTime    @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  member  ProjectMember @relation(fields: [projectMemberId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectMemberId, role])
  @@index([projectId, role])
  @@map("project_member_roles")
}

model ProjectTeamRole {
  id            String      @id @default(uuid()) @db.Uuid
  projectId     String      @db.Uuid
  projectTeamId String      @db.Uuid
  role          ProjectRole
  createdAt     DateTime    @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  team    ProjectTeam @relation(fields: [projectTeamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectTeamId, role])
  @@index([projectId, role])
  @@map("project_team_roles")
}

model Season {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  number      Int
  title       String?      @db.VarChar(200)
  description String?
  status      SeasonStatus @default(DRAFT)
  version     Int          @default(1)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  episodes Episode[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, archivedAt])
  @@index([archivedAt])
  @@map("seasons")
}

model Episode {
  id              String        @id @default(uuid()) @db.Uuid
  seasonId        String        @db.Uuid
  projectId       String        @db.Uuid
  number          Int
  title           String?       @db.VarChar(200)
  synopsis        String?
  status          EpisodeStatus @default(DRAFT)
  version         Int           @default(1)
  durationSeconds Int?
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  season    Season     @relation(fields: [seasonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  script    Script?
  timelines Timeline[]

  @@unique([seasonId, number])
  @@index([seasonId, status])
  @@index([projectId, status])
  @@index([projectId, archivedAt])
  @@index([archivedAt])
  @@map("episodes")
}

model SourceDocument {
  id               String               @id @default(uuid()) @db.Uuid
  projectId        String               @db.Uuid
  name             String               @db.VarChar(200)
  documentType     SourceDocumentType
  status           SourceDocumentStatus @default(DRAFT)
  version          Int                  @default(1)
  currentVersionId String?              @unique @db.Uuid
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  project                  Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions                 SourceDocumentVersion[]   @relation("SourceDocumentVersions")
  currentVersion           SourceDocumentVersion?    @relation("SourceDocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  chapterEntityExtractions ChapterEntityExtraction[]

  @@index([projectId, status])
  @@index([projectId, archivedAt])
  @@index([archivedAt])
  @@map("source_documents")
}

model SourceDocumentVersion {
  id            String              @id @default(uuid()) @db.Uuid
  documentId    String              @db.Uuid
  version       Int
  fileName      String              @db.VarChar(255)
  fileExtension String?             @db.VarChar(20)
  mimeType      String?             @db.VarChar(120)
  byteSize      BigInt?
  sha256        String              @db.Char(64)
  storageKey    String              @db.VarChar(500)
  textContent   String?             @db.Text
  parserName    String?             @db.VarChar(100)
  parserVersion String?             @db.VarChar(50)
  status        SourceVersionStatus @default(IMPORTING)
  errorMessage  String?
  importedAt    DateTime            @default(now())
  parsedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  document                 SourceDocument            @relation("SourceDocumentVersions", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentOf                SourceDocument?           @relation("SourceDocumentCurrentVersion")
  segments                 SourceSegment[]
  scriptVersions           ScriptVersion[]
  chapterEntityExtractions ChapterEntityExtraction[]

  @@unique([documentId, version])
  @@index([documentId, status])
  @@index([sha256])
  @@map("source_document_versions")
}

model SourceSegment {
  id          String            @id @default(uuid()) @db.Uuid
  versionId   String            @db.Uuid
  parentId    String?           @db.Uuid
  type        SourceSegmentType
  ordinal     Int
  title       String?           @db.VarChar(300)
  content     String            @db.Text
  startOffset Int
  endOffset   Int
  startLine   Int?
  endLine     Int?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  version                  SourceDocumentVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent                   SourceSegment?            @relation("SourceSegmentTree", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children                 SourceSegment[]           @relation("SourceSegmentTree")
  scriptScenes             Scene[]                   @relation("SceneSourceSegment")
  scriptBeats              Beat[]                    @relation("BeatSourceSegment")
  scriptDialogues          Dialogue[]                @relation("DialogueSourceSegment")
  shotVersions             ShotVersion[]             @relation("ShotVersionSourceSegment")
  chapterEntityExtractions ChapterEntityExtraction[] @relation("ChapterEntityExtractionChapter")
  extractedEntityMentions  ExtractedEntityMention[]

  @@unique([versionId, ordinal])
  @@index([versionId, type])
  @@index([parentId])
  @@map("source_segments")
}

model ChapterEntityExtraction {
  id               String                        @id @default(uuid()) @db.Uuid
  projectId        String                        @db.Uuid
  sourceDocumentId String                        @db.Uuid
  sourceVersionId  String                        @db.Uuid
  chapterSegmentId String                        @db.Uuid
  extractorName    String                        @db.VarChar(120)
  extractorVersion String                        @db.VarChar(50)
  status           ChapterEntityExtractionStatus @default(PENDING)
  errorMessage     String?
  extractedAt      DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  project        Project               @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceDocument SourceDocument        @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceVersion  SourceDocumentVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chapterSegment SourceSegment         @relation("ChapterEntityExtractionChapter", fields: [chapterSegmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entities       ExtractedEntity[]

  @@unique([sourceVersionId, chapterSegmentId, extractorName, extractorVersion])
  @@index([projectId, status])
  @@index([sourceDocumentId])
  @@index([chapterSegmentId])
  @@map("chapter_entity_extractions")
}

model ExtractedEntity {
  id             String              @id @default(uuid()) @db.Uuid
  extractionId   String              @db.Uuid
  type           ExtractedEntityType
  name           String              @db.VarChar(300)
  normalizedName String              @db.VarChar(300)
  description    String?
  attributes     Json?
  confidence     Float?
  ordinal        Int
  createdAt      DateTime            @default(now())

  extraction ChapterEntityExtraction  @relation(fields: [extractionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mentions   ExtractedEntityMention[]

  @@unique([extractionId, ordinal])
  @@index([extractionId, type])
  @@index([type, normalizedName])
  @@map("extracted_entities")
}

model ExtractedEntityMention {
  id                String   @id @default(uuid()) @db.Uuid
  extractedEntityId String   @db.Uuid
  sourceSegmentId   String   @db.Uuid
  text              String   @db.Text
  startOffset       Int
  endOffset         Int
  startLine         Int?
  endLine           Int?
  evidence          String?
  confidence        Float?
  ordinal           Int
  createdAt         DateTime @default(now())

  extractedEntity ExtractedEntity @relation(fields: [extractedEntityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceSegment   SourceSegment   @relation(fields: [sourceSegmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([extractedEntityId, ordinal])
  @@index([sourceSegmentId, startOffset])
  @@map("extracted_entity_mentions")
}

model Script {
  id               String       @id @default(uuid()) @db.Uuid
  projectId        String       @db.Uuid
  episodeId        String       @unique @db.Uuid
  title            String       @db.VarChar(200)
  status           ScriptStatus @default(DRAFT)
  version          Int          @default(1)
  currentVersionId String?      @unique @db.Uuid
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  episode        Episode         @relation(fields: [episodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions       ScriptVersion[] @relation("ScriptVersions")
  currentVersion ScriptVersion?  @relation("ScriptCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([projectId, status])
  @@index([projectId, archivedAt])
  @@index([archivedAt])
  @@map("scripts")
}

model ScriptVersion {
  id              String               @id @default(uuid()) @db.Uuid
  scriptId        String               @db.Uuid
  version         Int
  parentVersionId String?              @db.Uuid
  sourceVersionId String?              @db.Uuid
  title           String               @db.VarChar(200)
  synopsis        String?
  adaptationMode  ScriptAdaptationMode @default(STANDARD)
  status          ScriptVersionStatus  @default(DRAFT)
  changeSummary   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  script        Script                 @relation("ScriptVersions", fields: [scriptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentVersion ScriptVersion?         @relation("ScriptVersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childVersions ScriptVersion[]        @relation("ScriptVersionLineage")
  sourceVersion SourceDocumentVersion? @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentOf     Script?                @relation("ScriptCurrentVersion")
  scenes        Scene[]
  shots         Shot[]
  shotVersions  ShotVersion[]

  @@unique([scriptId, version])
  @@index([scriptId, status])
  @@index([parentVersionId])
  @@index([sourceVersionId])
  @@map("script_versions")
}

model Scene {
  id               String   @id @default(uuid()) @db.Uuid
  scriptVersionId  String   @db.Uuid
  sourceSegmentId  String?  @db.Uuid
  ordinal          Int
  heading          String   @db.VarChar(300)
  interiorExterior String?  @db.VarChar(20)
  timeOfDay        String?  @db.VarChar(100)
  location         String?  @db.VarChar(300)
  atmosphere       String?
  summary          String?
  action           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scriptVersion ScriptVersion     @relation(fields: [scriptVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceSegment SourceSegment?    @relation("SceneSourceSegment", fields: [sourceSegmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  beats         Beat[]
  dialogues     Dialogue[]
  continuities  SceneContinuity[]

  @@unique([scriptVersionId, ordinal])
  @@index([sourceSegmentId])
  @@map("scenes")
}

model Beat {
  id              String   @id @default(uuid()) @db.Uuid
  sceneId         String   @db.Uuid
  sourceSegmentId String?  @db.Uuid
  ordinal         Int
  type            BeatType
  summary         String   @db.Text
  action          String?
  emotionalState  String?  @db.VarChar(200)
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  scene         Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceSegment SourceSegment? @relation("BeatSourceSegment", fields: [sourceSegmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  dialogues     Dialogue[]
  shots         Shot[]

  @@unique([sceneId, ordinal])
  @@index([sourceSegmentId])
  @@map("beats")
}

model Dialogue {
  id              String       @id @default(uuid()) @db.Uuid
  sceneId         String       @db.Uuid
  beatId          String?      @db.Uuid
  sourceSegmentId String?      @db.Uuid
  ordinal         Int
  type            DialogueType @default(SPOKEN)
  speaker         String       @db.VarChar(200)
  parenthetical   String?
  text            String       @db.Text
  delivery        String?
  createdAt       DateTime     @default(now())
