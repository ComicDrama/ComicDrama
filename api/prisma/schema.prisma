generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EpisodeStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  ARCHIVED
}

enum SourceDocumentType {
  TXT
  MARKDOWN
  DOCX
  EPUB
  PDF
  FOUNTAIN
  FINAL_DRAFT_XML
  UNKNOWN
}

enum SourceDocumentStatus {
  DRAFT
  IMPORTING
  READY
  FAILED
  ARCHIVED
}

enum SourceVersionStatus {
  IMPORTING
  PARSING
  READY
  FAILED
}

enum SourceSegmentType {
  DOCUMENT
  CHAPTER
  SECTION
  PARAGRAPH
}

enum ScriptStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  ARCHIVED
}

enum ScriptVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum ScriptAdaptationMode {
  SIMPLE
  STANDARD
  COMPLETE
}

enum BeatType {
  ACTION
  REVEAL
  EMOTION
  TRANSITION
  DIALOGUE
  MONTAGE
}

enum DialogueType {
  SPOKEN
  VOICE_OVER
  OFF_SCREEN
  WHISPER
  SHOUT
}

enum ShotStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  ARCHIVED
}

enum ShotVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum ShotDependencyType {
  CONTINUITY
  MATCH_CUT
  CARRY_OVER
  REFERENCE
  TIMELINE
}

enum StoryboardPanelType {
  KEYFRAME
  THUMBNAIL
  CAMERA_BOARD
  ANNOTATION
}

enum GenerationStrategy {
  NONE
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  KEYFRAME_TO_VIDEO
}

enum AssetType {
  CHARACTER
  LOCATION
  PROP
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STYLE
  OTHER
}

enum AssetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssetVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum CharacterStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CharacterAppearanceType {
  TURNAROUND
  FRONT
  SIDE
  BACK
  EXPRESSION
  POSE
  COSTUME
  REFERENCE
  OTHER
}

enum VoiceProfileStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LocationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LocationVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum PropStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SceneContinuitySubject {
  CHARACTER
  LOCATION
  PROP
  OTHER
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(120)
  name        String        @db.VarChar(200)
  description String?
  status      ProjectStatus @default(DRAFT)
  version     Int           @default(1)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seasons          Season[]
  sourceDocuments  SourceDocument[]
  assets           Asset[]
  assetCollections AssetCollection[]
  characters       Character[]
  locations        Location[]
  props            Prop[]

  @@index([status])
  @@index([archivedAt])
  @@map("projects")
}

model Season {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  number      Int
  title       String?      @db.VarChar(200)
  description String?
  status      SeasonStatus @default(DRAFT)
  version     Int          @default(1)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  episodes Episode[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([archivedAt])
  @@map("seasons")
}

model Episode {
  id              String        @id @default(uuid()) @db.Uuid
  seasonId        String        @db.Uuid
  number          Int
  title           String?       @db.VarChar(200)
  synopsis        String?
  status          EpisodeStatus @default(DRAFT)
  version         Int           @default(1)
  durationSeconds Int?
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  season Season  @relation(fields: [seasonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  script Script?

  @@unique([seasonId, number])
  @@index([seasonId, status])
  @@index([archivedAt])
  @@map("episodes")
}

model SourceDocument {
  id               String               @id @default(uuid()) @db.Uuid
  projectId        String               @db.Uuid
  name             String               @db.VarChar(200)
  documentType     SourceDocumentType
  status           SourceDocumentStatus @default(DRAFT)
  currentVersionId String?              @unique @db.Uuid
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions       SourceDocumentVersion[] @relation("SourceDocumentVersions")
  currentVersion SourceDocumentVersion?  @relation("SourceDocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([projectId, status])
  @@index([archivedAt])
  @@map("source_documents")
}

model SourceDocumentVersion {
  id            String              @id @default(uuid()) @db.Uuid
  documentId    String              @db.Uuid
  version       Int
  fileName      String              @db.VarChar(255)
  fileExtension String?             @db.VarChar(20)
  mimeType      String?             @db.VarChar(120)
  byteSize      BigInt?
  sha256        String              @db.Char(64)
  storageKey    String              @db.VarChar(500)
  textContent   String?             @db.Text
  parserName    String?             @db.VarChar(100)
  parserVersion String?             @db.VarChar(50)
  status        SourceVersionStatus @default(IMPORTING)
  errorMessage  String?
  importedAt    DateTime            @default(now())
  parsedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  document       SourceDocument  @relation("SourceDocumentVersions", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentOf      SourceDocument? @relation("SourceDocumentCurrentVersion")
  segments       SourceSegment[]
  scriptVersions ScriptVersion[]

  @@unique([documentId, version])
  @@index([documentId, status])
  @@index([sha256])
  @@map("source_document_versions")
}

model SourceSegment {
  id          String            @id @default(uuid()) @db.Uuid
  versionId   String            @db.Uuid
  parentId    String?           @db.Uuid
  type        SourceSegmentType
  ordinal     Int
  title       String?           @db.VarChar(300)
  content     String            @db.Text
  startOffset Int
  endOffset   Int
  startLine   Int?
  endLine     Int?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  version         SourceDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent          SourceSegment?        @relation("SourceSegmentTree", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children        SourceSegment[]       @relation("SourceSegmentTree")
  scriptScenes    Scene[]               @relation("SceneSourceSegment")
  scriptBeats     Beat[]                @relation("BeatSourceSegment")
  scriptDialogues Dialogue[]            @relation("DialogueSourceSegment")
  shotVersions    ShotVersion[]         @relation("ShotVersionSourceSegment")

  @@unique([versionId, ordinal])
  @@index([versionId, type])
  @@index([parentId])
  @@map("source_segments")
}

model Script {
  id               String       @id @default(uuid()) @db.Uuid
  episodeId        String       @unique @db.Uuid
  title            String       @db.VarChar(200)
  status           ScriptStatus @default(DRAFT)
  currentVersionId String?      @unique @db.Uuid
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  episode        Episode         @relation(fields: [episodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions       ScriptVersion[] @relation("ScriptVersions")
  currentVersion ScriptVersion?  @relation("ScriptCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([archivedAt])
  @@map("scripts")
}

model ScriptVersion {
  id              String               @id @default(uuid()) @db.Uuid
  scriptId        String               @db.Uuid
  version         Int
  parentVersionId String?              @db.Uuid
  sourceVersionId String?              @db.Uuid
  title           String               @db.VarChar(200)
  synopsis        String?
  adaptationMode  ScriptAdaptationMode @default(STANDARD)
  status          ScriptVersionStatus  @default(DRAFT)
  changeSummary   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  script        Script                 @relation("ScriptVersions", fields: [scriptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentVersion ScriptVersion?         @relation("ScriptVersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childVersions ScriptVersion[]        @relation("ScriptVersionLineage")
  sourceVersion SourceDocumentVersion? @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentOf     Script?                @relation("ScriptCurrentVersion")
  scenes        Scene[]
  shots         Shot[]
  shotVersions  ShotVersion[]

  @@unique([scriptId, version])
  @@index([scriptId, status])
  @@index([parentVersionId])
  @@index([sourceVersionId])
  @@map("script_versions")
}

model Scene {
  id               String   @id @default(uuid()) @db.Uuid
  scriptVersionId  String   @db.Uuid
  sourceSegmentId  String?  @db.Uuid
  ordinal          Int
  heading          String   @db.VarChar(300)
  interiorExterior String?  @db.VarChar(20)
  timeOfDay        String?  @db.VarChar(100)
  location         String?  @db.VarChar(300)
  atmosphere       String?
  summary          String?
  action           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scriptVersion ScriptVersion     @relation(fields: [scriptVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceSegment SourceSegment?    @relation("SceneSourceSegment", fields: [sourceSegmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  beats         Beat[]
  dialogues     Dialogue[]
  continuities  SceneContinuity[]

  @@unique([scriptVersionId, ordinal])
  @@index([sourceSegmentId])
  @@map("scenes")
}

model Beat {
  id              String   @id @default(uuid()) @db.Uuid
  sceneId         String   @db.Uuid
  sourceSegmentId String?  @db.Uuid
  ordinal         Int
  type            BeatType
  summary         String   @db.Text
  action          String?
  emotionalState  String?  @db.VarChar(200)
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  scene         Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceSegment SourceSegment? @relation("BeatSourceSegment", fields: [sourceSegmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  dialogues     Dialogue[]
  shots         Shot[]

  @@unique([sceneId, ordinal])
  @@index([sourceSegmentId])
  @@map("beats")
}

model Dialogue {
  id              String       @id @default(uuid()) @db.Uuid
  sceneId         String       @db.Uuid
  beatId          String?      @db.Uuid
  sourceSegmentId String?      @db.Uuid
  ordinal         Int
  type            DialogueType @default(SPOKEN)
  speaker         String       @db.VarChar(200)
  parenthetical   String?
  text            String       @db.Text
  delivery        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  scene         Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  beat          Beat?          @relation(fields: [beatId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sourceSegment SourceSegment? @relation("DialogueSourceSegment", fields: [sourceSegmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([sceneId, ordinal])
  @@index([beatId])
  @@index([sourceSegmentId])
  @@map("dialogues")
}

model Shot {
  id               String     @id @default(uuid()) @db.Uuid
  scriptVersionId  String     @db.Uuid
  beatId           String     @db.Uuid
  ordinal          Int
  title            String?    @db.VarChar(200)
  status           ShotStatus @default(DRAFT)
  currentVersionId String?    @unique @db.Uuid
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  archivedAt       DateTime?

  scriptVersion  ScriptVersion    @relation(fields: [scriptVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  beat           Beat             @relation(fields: [beatId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions       ShotVersion[]    @relation("ShotVersions")
  currentVersion ShotVersion?     @relation("ShotCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  outgoingDeps   ShotDependency[] @relation("ShotDependencyFrom")
  incomingDeps   ShotDependency[] @relation("ShotDependencyTo")

  @@unique([beatId, ordinal])
  @@index([scriptVersionId, status])
  @@index([status])
  @@index([archivedAt])
  @@map("shots")
}

model ShotVersion {
  id                 String             @id @default(uuid()) @db.Uuid
  shotId             String             @db.Uuid
  scriptVersionId    String             @db.Uuid
  parentVersionId    String?            @db.Uuid
  sourceSegmentId    String?            @db.Uuid
  version            Int
  durationFrames     Int
  shotSize           String?            @db.VarChar(80)
  cameraAngle        String?            @db.VarChar(100)
  cameraMovement     String?            @db.VarChar(150)
  lens               String?            @db.VarChar(80)
  action             String?
  dialogueNotes      String?
  generationStrategy GenerationStrategy @default(NONE)
  characterRefs      Json?
  characterActions   Json?
  lighting           Json?
  composition        Json?
  continuity         Json?
  audio              Json?
  promptNotes        String?
  status             ShotVersionStatus  @default(DRAFT)
  changeSummary      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  shot            Shot              @relation("ShotVersions", fields: [shotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scriptVersion   ScriptVersion     @relation(fields: [scriptVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentVersion   ShotVersion?      @relation("ShotVersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childVersions   ShotVersion[]     @relation("ShotVersionLineage")
  sourceSegment   SourceSegment?    @relation("ShotVersionSourceSegment", fields: [sourceSegmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  currentOf       Shot?             @relation("ShotCurrentVersion")
  panels          StoryboardPanel[]
  assetReferences AssetReference[]

  @@unique([shotId, version])
  @@index([scriptVersionId, status])
  @@index([parentVersionId])
  @@index([sourceSegmentId])
  @@map("shot_versions")
}

model ShotDependency {
  id         String             @id @default(uuid()) @db.Uuid
  fromShotId String             @db.Uuid
  toShotId   String             @db.Uuid
  type       ShotDependencyType
  notes      String?
  createdAt  DateTime           @default(now())

  fromShot Shot @relation("ShotDependencyFrom", fields: [fromShotId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  toShot   Shot @relation("ShotDependencyTo", fields: [toShotId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([fromShotId, toShotId, type])
  @@index([toShotId])
  @@map("shot_dependencies")
}

model StoryboardPanel {
  id            String              @id @default(uuid()) @db.Uuid
  shotVersionId String              @db.Uuid
  ordinal       Int
  type          StoryboardPanelType @default(KEYFRAME)
  storageKey    String?             @db.VarChar(500)
  thumbnailKey  String?             @db.VarChar(500)
  mimeType      String?             @db.VarChar(120)
  sha256        String?             @db.Char(64)
  width         Int?
  height        Int?
  caption       String?
  annotations   Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  shotVersion ShotVersion @relation(fields: [shotVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([shotVersionId, ordinal])
  @@index([shotVersionId, type])
  @@map("storyboard_panels")
}

model Character {
  id                    String          @id @default(uuid()) @db.Uuid
  projectId             String?         @db.Uuid
  assetId               String?         @unique @db.Uuid
  currentAppearanceId   String?         @unique @db.Uuid
  name                  String          @db.VarChar(200)
  slug                  String?         @db.VarChar(120)
  aliases               Json?
  role                  String?         @db.VarChar(120)
  gender                String?         @db.VarChar(80)
  ageDescription        String?         @db.VarChar(120)
  personality           String?
  background            String?
  appearanceDescription String?
  costumeDescription    String?
  status                CharacterStatus @default(DRAFT)
  archivedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  project           Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  asset             Asset?                @relation("CharacterAsset", fields: [assetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  currentAppearance CharacterAppearance?  @relation("CharacterCurrentAppearance", fields: [currentAppearanceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  appearances       CharacterAppearance[] @relation("CharacterAppearances")
  voiceProfiles     VoiceProfile[]
  continuities      SceneContinuity[]     @relation("CharacterSceneContinuity")

  @@unique([projectId, slug])
  @@index([projectId, status])
  @@index([status])
  @@map("characters")
}

model CharacterAppearance {
  id             String                  @id @default(uuid()) @db.Uuid
  characterId    String                  @db.Uuid
  assetVersionId String                  @db.Uuid
  type           CharacterAppearanceType @default(REFERENCE)
  label          String?                 @db.VarChar(200)
  ordinal        Int                     @default(0)
  costume        String?
  expression     String?
  pose           String?
  cameraAngle    String?                 @db.VarChar(100)
  isPrimary      Boolean                 @default(false)
  metadata       Json?
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  character    Character    @relation("CharacterAppearances", fields: [characterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assetVersion AssetVersion @relation("CharacterAppearanceAssetVersion", fields: [assetVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentOf    Character?   @relation("CharacterCurrentAppearance")

  @@unique([characterId, assetVersionId, type])
  @@index([characterId, type])
  @@index([assetVersionId])
  @@map("character_appearances")
}

model VoiceProfile {
  id                   String             @id @default(uuid()) @db.Uuid
  characterId          String             @db.Uuid
  sampleAssetVersionId String?            @db.Uuid
  name                 String             @db.VarChar(200)
  provider             String?            @db.VarChar(120)
  voiceId              String?            @db.VarChar(200)
  language             String?            @db.VarChar(40)
  locale               String?            @db.VarChar(40)
  gender               String?            @db.VarChar(40)
  pitch                Float?
  speed                Float?
  style                String?
  status               VoiceProfileStatus @default(DRAFT)
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  character          Character     @relation(fields: [characterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sampleAssetVersion AssetVersion? @relation("VoiceSampleAssetVersion", fields: [sampleAssetVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([characterId, name])
  @@index([characterId, status])
  @@index([sampleAssetVersionId])
  @@map("voice_profiles")
}

model Location {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String?        @db.Uuid
  assetId          String?        @unique @db.Uuid
  currentVersionId String?        @unique @db.Uuid
  name             String         @db.VarChar(200)
  slug             String?        @db.VarChar(120)
  locationType     String?        @db.VarChar(120)
  description      String?
  status           LocationStatus @default(DRAFT)
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  asset          Asset?            @relation("LocationAsset", fields: [assetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions       LocationVersion[] @relation("LocationVersions")
  currentVersion LocationVersion?  @relation("LocationCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  continuities   SceneContinuity[] @relation("LocationSceneContinuity")

  @@unique([projectId, slug])
  @@index([projectId, status])
  @@index([status])
  @@map("locations")
}

model LocationVersion {
  id              String                @id @default(uuid()) @db.Uuid
  locationId      String                @db.Uuid
  parentVersionId String?               @db.Uuid
  assetVersionId  String?               @db.Uuid
  version         Int
  status          LocationVersionStatus @default(DRAFT)
  layout          Json?
  lighting        Json?
  timeOfDay       String?               @db.VarChar(100)
  weather         String?               @db.VarChar(100)
  continuityRules Json?
  prompt          String?
  metadata        Json?
  changeSummary   String?
  createdAt       DateTime              @default(now())

  location      Location          @relation("LocationVersions", fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentVersion LocationVersion?  @relation("LocationVersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childVersions LocationVersion[] @relation("LocationVersionLineage")
  assetVersion  AssetVersion?     @relation("LocationVersionAsset", fields: [assetVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  currentOf     Location?         @relation("LocationCurrentVersion")

  @@unique([locationId, version])
  @@index([locationId, status])
  @@index([parentVersionId])
  @@index([assetVersionId])
  @@map("location_versions")
}

model SceneContinuity {
  id          String                 @id @default(uuid()) @db.Uuid
  sceneId     String                 @db.Uuid
  ordinal     Int
  subjectType SceneContinuitySubject
  characterId String?                @db.Uuid
  locationId  String?                @db.Uuid
  propId      String?                @db.Uuid
  stateKey    String                 @db.VarChar(120)
  stateValue  String?
  notes       String?
  metadata    Json?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  scene     Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  character Character? @relation("CharacterSceneContinuity", fields: [characterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  location  Location?  @relation("LocationSceneContinuity", fields: [locationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  prop      Prop?      @relation("PropSceneContinuity", fields: [propId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([sceneId, ordinal])
  @@index([characterId])
  @@index([locationId])
  @@index([propId])
  @@index([sceneId, subjectType])
  @@map("scene_continuities")
}

model Prop {
  id               String     @id @default(uuid()) @db.Uuid
  projectId        String?    @db.Uuid
  assetId          String?    @unique @db.Uuid
  currentVersionId String?    @unique @db.Uuid
  name             String     @db.VarChar(200)
  slug             String?    @db.VarChar(120)
  category         String?    @db.VarChar(120)
  description      String?
  material         String?    @db.VarChar(200)
  dimensions       Json?
  defaultState     String?
  status           PropStatus @default(DRAFT)
  archivedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  asset          Asset?            @relation("PropAsset", fields: [assetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  currentVersion AssetVersion?     @relation("PropCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  continuities   SceneContinuity[] @relation("PropSceneContinuity")

  @@unique([projectId, slug])
  @@index([projectId, status])
  @@index([status])
  @@map("props")
}

model Asset {
  id               String      @id @default(uuid()) @db.Uuid
  projectId        String?     @db.Uuid
  name             String      @db.VarChar(200)
  slug             String?     @db.VarChar(120)
  type             AssetType
  status           AssetStatus @default(DRAFT)
  currentVersionId String?     @unique @db.Uuid
  archivedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project        Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions       AssetVersion[]        @relation("AssetVersions")
  currentVersion AssetVersion?         @relation("AssetCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  collections    AssetCollectionItem[]
  references     AssetReference[]
  character      Character?            @relation("CharacterAsset")
  location       Location?             @relation("LocationAsset")
  prop           Prop?                 @relation("PropAsset")

  @@unique([projectId, slug])
  @@index([projectId, type, status])
  @@index([status])
  @@index([archivedAt])
  @@map("assets")
}

model AssetVersion {
  id              String             @id @default(uuid()) @db.Uuid
  assetId         String             @db.Uuid
  parentVersionId String?            @db.Uuid
  version         Int
  status          AssetVersionStatus @default(DRAFT)
  fileName        String?            @db.VarChar(255)
  mimeType        String?            @db.VarChar(120)
  byteSize        BigInt?
  sha256          String?            @db.Char(64)
  storageKey      String?            @db.VarChar(500)
  width           Int?
  height          Int?
  durationMs      Int?
  metadata        Json?
  prompt          String?
  changeSummary   String?
  createdAt       DateTime           @default(now())

  asset                Asset                 @relation("AssetVersions", fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentVersion        AssetVersion?         @relation("AssetVersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childVersions        AssetVersion[]        @relation("AssetVersionLineage")
  currentOf            Asset?                @relation("AssetCurrentVersion")
  references           AssetReference[]
  collectionPins       AssetCollectionItem[]
  characterAppearances CharacterAppearance[] @relation("CharacterAppearanceAssetVersion")
  locationVersions     LocationVersion[]     @relation("LocationVersionAsset")
  propCurrents         Prop[]                @relation("PropCurrentVersion")
  voiceSamples         VoiceProfile[]        @relation("VoiceSampleAssetVersion")

  @@unique([assetId, version])
  @@index([status])
  @@index([parentVersionId])
  @@index([sha256])
  @@map("asset_versions")
}

model AssetCollection {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String?  @db.Uuid
  name      String   @db.VarChar(200)
  slug      String?  @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items   AssetCollectionItem[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("asset_collections")
}

model AssetCollectionItem {
  id              String   @id @default(uuid()) @db.Uuid
  collectionId    String   @db.Uuid
  assetId         String   @db.Uuid
  pinnedVersionId String?  @db.Uuid
  createdAt       DateTime @default(now())

  collection    AssetCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  asset         Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pinnedVersion AssetVersion?   @relation(fields: [pinnedVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([collectionId, assetId])
  @@index([assetId])
  @@index([pinnedVersionId])
  @@map("asset_collection_items")
}

model AssetReference {
  id             String   @id @default(uuid()) @db.Uuid
  assetId        String   @db.Uuid
  assetVersionId String   @db.Uuid
  targetType     String   @db.VarChar(50)
  targetId       String   @db.Uuid
  role           String?  @db.VarChar(80)
  notes          String?
  metadata       Json?
  createdAt      DateTime @default(now())

  asset         Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assetVersion  AssetVersion @relation(fields: [assetVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shotVersion   ShotVersion? @relation(fields: [shotVersionId], references: [id])
  shotVersionId String?      @db.Uuid

  @@unique([assetVersionId, targetType, targetId, role])
  @@index([assetId, targetType])
  @@index([assetVersionId])
  @@index([targetType, targetId])
  @@map("asset_references")
}
